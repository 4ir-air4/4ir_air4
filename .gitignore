# =========================
# Python 가상환경
# =========================
.venv/
venv/
env/

# =========================
# Python 캐시 파일
# =========================
__pycache__/
*.py[cod]
*$py.class

# =========================
# 환경변수 및 비밀정보
# =========================
.env
.env.*
!.env.example

# =========================
# Jupyter Notebook
# =========================
.ipynb_checkpoints/

# =========================
# 테스트 및 분석 도구
# =========================
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# =========================
# Streamlit
# =========================
.streamlit/secrets.toml

# =========================
# IDE 설정
# =========================
.idea/
.vscode/

# =========================
# 운영체제 임시 파일
# =========================
.DS_Store
Thumbs.db
desktop.ini

# =========================
# 로그 파일
# =========================
*.log

# =========================
# 데이터 / 모델 산출물 (용량 큼)
# =========================
bts_data/
data/
reference_data/
outputs/
# 팀원 sjw 가 화면용으로 내보낸 정적 결과(공공 API 자료, 약 5MB)는 올린다 (2026-11-17)
!/sjw/outputs/
outputs_*/
_archive_before_2020/

# =========================
# 팀원 앱(ojh/live_app.py) 쪽 추가 규칙
# =========================
ENV/
*.tmp
*.bak

# 개인 PC 실행 설정
.claude/launch.json

# 정리한 데이터 폴더 (2026-11-11): 입력 자료와 결과. reference 에는 재배포 제한 자료가 있어 절대 올리지 않는다
datasets/
# 결과(2026-11-16): 화면이 읽는 가벼운 결과만 올린다. 저장 모델, 원 예측값, 큰 건별 예측(미국 운항·기상, OpenSky 재배포 제한)은 드라이브로 공유
/ldh/results/*
!/ldh/results/full/
!/ldh/results/2026/
# 미국 운항 화면 '직접 예측' 보기가 읽는 예전 모델 11개(압축 약 13MB). 하위 폴더(enhanced, metrics)는 제외
!/ldh/results/legacy_models/
/ldh/results/legacy_models/*/
/ldh/results/*/*/saved_models/
/ldh/results/*/*/member_preds/
/ldh/results/full/us_flights/pred_*.parquet
/ldh/results/full/us_weather/pred_*.parquet
/ldh/results/full/world_traffic/pred_*.parquet
# 위 큰 예측의 화면용 무작위 표본(ldh/scripts/sample_preds.py)은 올린다
!/ldh/results/full/*/pred_sample_*.parquet

# =========================
# ojh/ (JhonOh 작업 폴더)
# =========================
ojh/models/*
!ojh/models/train.py
!ojh/models/train2.py
!ojh/models/train_apron_yolo.ipynb
!ojh/models/autolabel_apron.ipynb
!ojh/models/consensus_apron.ipynb
# 계류장 화면의 차량 종류 맞히기 코드 (2026-11-26). 모델 파일·학습 데이터(saved/yolo/veh_types)는 계속 제외
!ojh/models/veh_classify.py
!ojh/models/veh_final.py
!ojh/models/veh_backbones.py
!ojh/models/veh_report.py
# 화면용 학습 모델(2026-11-16, 압축 저장해 약 86MB). 재학습하면 joblib compress 로 저장해야 GitHub 100MB 한도를 넘지 않는다
!ojh/models/saved/
# YOLO 가중치(약 100MB)는 계류장 화면이 처음 실행할 때 내려받는다
ojh/models/saved/yolo/
ojh/data/airport_demand/input/
ojh/data/cache/*
ojh/data/raw/
